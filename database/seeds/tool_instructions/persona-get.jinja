{% if persona %}
## Persona: {{ persona.name or '(unnamed)' }}

{% if persona.description %}{{ persona.description }}{% endif %}

{% if persona.color %}**Color:** {{ persona.color.name }} ({{ persona.color.hex_code }}){% endif %}
{% if persona.icon %}**Icon:** {{ persona.icon.name }} ({{ persona.icon.value }}){% endif %}
{% if persona.instructions %}**Instructions:** {{ persona.instructions.template[:200] }}{% if persona.instructions.template|length > 200 %}...{% endif %}{% endif %}

{% if persona.examples and persona.examples|length > 0 %}
### Examples
{% for ex in persona.examples %}- {{ ex.example[:100] }}{% if ex.example|length > 100 %}...{% endif %}
{% endfor %}
{% endif %}

{% if persona.departments and persona.departments|length > 0 %}
### Departments
{% for dept in persona.departments %}- {{ dept.name }}
{% endfor %}
{% endif %}

{% if persona.flags and persona.flags|length > 0 %}
### Flags
{% for flag in persona.flags %}- {{ flag.name }}
{% endfor %}
{% endif %}
{% else %}
No persona found.
{% endif %}

{% if available_colors and available_colors|length > 0 %}
### Available Colors
{% for c in available_colors %}- `{{ c.id }}` — {{ c.name }} ({{ c.hex_code }})
{% endfor %}
{% endif %}

{% if available_icons and available_icons|length > 0 %}
### Available Icons
{% for i in available_icons %}- `{{ i.id }}` — {{ i.name }} ({{ i.value }})
{% endfor %}
{% endif %}

{% if available_instructions and available_instructions|length > 0 %}
### Available Instructions
{% for inst in available_instructions %}- `{{ inst.id }}` — {{ inst.template[:80] }}{% if inst.template|length > 80 %}...{% endif %}
{% endfor %}
{% endif %}
