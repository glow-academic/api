{% macro render_compressed(section, label, display_field, display_truncate) -%}
{% if section and section.show and section.resources -%}
**{{ label }}:** {% for item in section.resources %}{{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}{% if not loop.last %}, {% endif %}{% endfor %}
{% elif section and section.show and section.current and not section.resources -%}
**{{ label }} (locked):** {% for item in section.current %}{{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif -%}
{% endmacro -%}
{% macro render_with_ids(section, label, id_field, display_field, display_truncate) -%}
{% if section and section.show and section.resources -%}
**{{ label }}:**
{% for item in section.resources %}- `{{ item[id_field] }}` — {{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}
{% endfor -%}
{% elif section and section.show and section.current and not section.resources -%}
**{{ label }} (locked):**
{% for item in section.current %}- `{{ item[id_field] }}` — {{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}
{% endfor -%}
{% endif -%}
{% endmacro -%}
