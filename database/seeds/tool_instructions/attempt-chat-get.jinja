{% macro render_compressed(items, label, display_field, display_truncate) -%}
{% if items is not none -%}
{% set suggested = items | selectattr('suggested') | list -%}
{% set selected = items | selectattr('selected') | list -%}
{% if suggested -%}
**{{ label }}:** {% for item in suggested %}{{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}{% if not loop.last %}, {% endif %}{% endfor %}
{% elif selected -%}
**{{ label }} (locked):** {% for item in selected %}{{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif -%}
{% endif -%}
{% endmacro -%}
{% macro render_with_ids(items, label, id_field, display_field, display_truncate) -%}
{% if items is not none -%}
{% set suggested = items | selectattr('suggested') | list -%}
{% set selected = items | selectattr('selected') | list -%}
{% if suggested -%}
**{{ label }}:**
{% for item in suggested %}- `{{ item[id_field] }}` — {{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}
{% endfor -%}
{% elif selected -%}
**{{ label }} (locked):**
{% for item in selected %}- `{{ item[id_field] }}` — {{ item[display_field][:display_truncate] if item[display_field] else '(no text)' }}
{% endfor -%}
{% endif -%}
{% endif -%}
{% endmacro -%}
{{ render_compressed(r.personas, 'Personas (pass names)', 'name', 60) -}}
{{ render_compressed(r.documents, 'Documents (pass names)', 'name', 60) -}}
{% if r.parameter_fields is not none -%}
{% set pf_suggested = r.parameter_fields | selectattr('suggested') | list -%}
{% if pf_suggested -%}
**Parameter Fields (pass names via `parameter_fields`):**
{% set ns = namespace(groups={}) -%}
{% for pf in pf_suggested -%}
{% set grp = pf.parameter_name or 'Other' -%}
{% if grp not in ns.groups -%}{% if ns.groups.update({grp: []}) -%}{% endif -%}{% endif -%}
{% if ns.groups[grp].append(pf.name or '?') -%}{% endif -%}
{% endfor -%}
{% for grp, names in ns.groups.items() -%}
- **{{ grp }}:** {{ names | join(', ') }}
{% endfor -%}
{% endif -%}
{% endif -%}
