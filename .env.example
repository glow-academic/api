# Production: 3 required env vars (no defaults)
# SECRET_KEY=your-secret-key
# ORIGIN=https://api.example.com
# CLIENT_ORIGINS=https://app.example.com,https://admin.example.com

# Project (optional; compose defaults for local dev)
COMPOSE_PROJECT_NAME=glow-api
ORIGIN=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000
APP_PREFIX=

# Database (optional; compose defaults for local dev)
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_NAME=mydb
# DB_BACKUP=  (unset = continue, set to restore from history/)

# Encryption (SECRET_KEY required for production)
SECRET_KEY=dev-secret-key-change-in-production

# Keycloak (optional; compose defaults)
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_REALM=master

# Redis (optional; in-memory when unset)
# REDIS_URL=redis://localhost:6379

# Deployment (production only)
# ACTIVE_ENV=blue
# API_SERVER_IMAGE=ghcr.io/learnloopllc/glow-api-server:latest
# API_DATABASE_IMAGE=ghcr.io/learnloopllc/glow-api-database:latest
