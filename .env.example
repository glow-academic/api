# Local development only — copy to .env and tweak as needed.
# Production .env files are generated by the glow CLI (see glow-academic/cli).

# Project
COMPOSE_PROJECT_NAME=glow-api
ORIGIN=http://localhost:3000
CLIENT_ORIGINS=http://localhost:3000
APP_PREFIX=

# Database (defaults match `make run`)
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_NAME=glowapi
# DB_BACKUP=  (unset = continue, set to restore from history/)

# Auth secret — any string is fine for local dev.
SECRET_KEY=dev-secret-key-change-in-production

# Keycloak
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_REALM=master

# Redis (in-memory when unset)
# REDIS_URL=redis://localhost:6379

# E2E auth bypass — accepts `Authorization: Bearer <token>` without JWT
# verification and resolves to the profile_artifact below by default
# (override per-request with `X-E2E-Profile-Id: <uuid>`).
# E2E_BYPASS_PROFILE_ID is the profile_artifact.id of any user you want
# tests/demos to act as — typically the superadmin of whatever seed
# you restored (fresh/university/organization each have their own).
# Generate token via: openssl rand -hex 32
# Local dev / Playwright demo recording ONLY. NEVER set in production.
# E2E_BYPASS_TOKEN=
# E2E_BYPASS_PROFILE_ID=
