# Project
COMPOSE_PROJECT_NAME=glow-api
ORIGIN=http://localhost:3000
APP_PREFIX=
CLIENT_PORT=3000

# Database
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydb
DB_OPERATION=auto

# Encryption
SECRET_KEY=dev-secret-key-change-in-production
AUTH_SECRET=dev-auth-secret-change-in-production

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=master
AUTH_KEYCLOAK_ID=glow-client
AUTH_CLIENT_ID=glow-client
AUTH_CLIENT_SECRET=change-me

# Client origin (for Keycloak redirect URIs when client is deployed separately)
CLIENT_ORIGIN=

# Redis
REDIS_URL=redis://localhost:6379

# Deployment (production only)
ACTIVE_ENV=blue
API_SERVER_IMAGE=ghcr.io/learnloopllc/glow-api-server:latest
API_DATABASE_IMAGE=ghcr.io/learnloopllc/glow-api-database:latest

# Testing
ENV=TEST
TESTCONTAINERS_REUSE_ENABLE=true
